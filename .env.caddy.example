# =============================================================================
# ALPHA — variables du proxy Caddy (projet compose « alpha-proxy », commun à la
# recette et à la production). Modèle versionné, AUCUN secret réel.
#
#     scripts/deploy.sh secrets caddy    # crée .env.caddy (600), génère le mot
#                                         # de passe des outils de recette et
#                                         # l'affiche UNE fois
# =============================================================================

# Adresse e-mail du compte ACME (Let's Encrypt / ZeroSSL) : avertissements
# d'expiration et de révocation des certificats.
ALPHA_ACME_EMAIL=A_RENSEIGNER

# Domaines publics, sans https:// (identiques à ceux de .env.recette et .env.prod).
# Leurs enregistrements DNS A (et AAAA si IPv6) doivent pointer vers le VPS AVANT
# le premier démarrage de Caddy, sinon l'obtention des certificats échoue.
ALPHA_DOMAINE_RECETTE=A_RENSEIGNER
ALPHA_DOMAINE_PROD=A_RENSEIGNER

# --- Console super-administrateur FYXOP (décision P6) -------------------------
# Adresses IP (ou plages CIDR) autorisées à joindre /console et
# /api/v1/plateforme/, séparées par des espaces. Exemple : 203.0.113.10/32 198.51.100.0/28
# Vide = PERSONNE depuis Internet (fermé par défaut ; seul 127.0.0.1 est autorisé).
# Option A, IP fixe de FYXOP : ALPHA_IP_CONSOLE_PROD=203.0.113.10/32
# Option B, VPN WireGuard (docs/ops/deploiement.md, § 9) : ALPHA_IP_CONSOLE_PROD=10.66.0.0/24
# Les deux options se combinent : ALPHA_IP_CONSOLE_PROD=203.0.113.10/32 10.66.0.0/24
ALPHA_IP_CONSOLE_PROD=
ALPHA_IP_CONSOLE_RECETTE=

# --- Outils de recette : Mailpit (/mailpit/) et documentation de l'API ---------
# Authentification HTTP Basic posée par Caddy. Le mot de passe en clair n'est
# PAS stocké ici : seulement son empreinte bcrypt (caddy hash-password).
# Les guillemets simples sont OBLIGATOIRES (l'empreinte contient des « $ »).
ALPHA_RECETTE_OUTILS_UTILISATEUR=recette
ALPHA_RECETTE_OUTILS_HASH='A_GENERER'
