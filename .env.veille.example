# =============================================================================
# ALPHA — variables de la machine de surveillance (docker-compose.veille.yml).
# Modèle versionné, aucun secret. Copie : .env.veille (600), jamais versionnée.
# =============================================================================
# Compte ACME (avertissements d'expiration des certificats).
ALPHA_ACME_EMAIL=A_RENSEIGNER
# Domaine de l'interface Uptime Kuma (ex. veille.mondomaine.sn) : enregistrement
# DNS A vers CETTE machine, pas vers le VPS ALPHA.
ALPHA_DOMAINE_VEILLE=A_RENSEIGNER
