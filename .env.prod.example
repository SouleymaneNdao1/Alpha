# =============================================================================
# ALPHA — variables de PRODUCTION (modèle versionné, AUCUN secret réel)
#
# Sur le VPS, depuis la racine du dépôt :
#     scripts/deploy.sh secrets prod      # crée .env.prod (droits 600) et génère
#                                          # chaque valeur A_GENERER
# puis remplacez à la main chaque A_RENSEIGNER. scripts/deploy.sh refuse de
# démarrer tant qu'il reste une valeur A_GENERER ou A_RENSEIGNER.
#
# .env.prod n'est JAMAIS versionné (.gitignore) ; conservez une copie de ses
# secrets dans le gestionnaire de mots de passe de FYXOP : sans
# ALPHA_CLES_CHIFFREMENT, une sauvegarde restaurée est en partie illisible
# (secrets TOTP chiffrés en base).
#
# Format : NOM=valeur, sans guillemets ni espaces autour du « = », fins de ligne LF.
# Mots de passe PostgreSQL : [A-Za-z0-9] uniquement (insérés dans des URL).
# =============================================================================

# --- Domaine public (sans https://) ------------------------------------------
# Exemple : app.mondomaine.sn. Doit être identique à ALPHA_DOMAINE_PROD de .env.caddy.
ALPHA_DOMAINE_PROD=A_RENSEIGNER

# --- PostgreSQL ---------------------------------------------------------------
# Lus UNE SEULE FOIS, à la création du volume de données (01-roles.sh) :
# ne les changez plus ensuite sans changer aussi les rôles dans la base.
POSTGRES_PASSWORD=A_GENERER
ALPHA_OWNER_PASSWORD=A_GENERER
ALPHA_APP_PASSWORD=A_GENERER
# Jamais de CREATEDB en production.
ALPHA_OWNER_CREATEDB=false
ALPHA_DB_NAME=alpha

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=A_GENERER
ALPHA_CLES_CHIFFREMENT=A_GENERER
ALPHA_HMAC_POIVRE=A_GENERER
# HSTS posé aussi par Django (en complément de Caddy). Préchargement : décision
# du titulaire du domaine, quasi irréversible ; laisser false pour le pilote.
ALPHA_HSTS_SECONDES=31536000
ALPHA_HSTS_PRELOAD=false
ALPHA_NIVEAU_JOURNAL=INFO

# --- E-mails (SMTP réel : Brevo, Mailjet, Amazon SES, Postmark…) --------------
EMAIL_HOST=A_RENSEIGNER
EMAIL_PORT=587
EMAIL_HOST_USER=A_RENSEIGNER
EMAIL_HOST_PASSWORD=A_RENSEIGNER
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Adresse d'expédition : le domaine doit être authentifié chez le fournisseur
# SMTP (SPF, DKIM, DMARC), sinon les messages partent en indésirables.
DEFAULT_FROM_EMAIL=ALPHA <no-reply@A_RENSEIGNER>
# Ancre quotidienne du journal d'audit et alertes de rupture de chaîne (P7).
ALPHA_EMAIL_SECURITE_FYXOP=A_RENSEIGNER

# --- Exploitation -------------------------------------------------------------
# Gunicorn : 3 processus x 2 fils (2 vCPU). Réduire si la mémoire manque.
ALPHA_GUNICORN_WORKERS=3
ALPHA_CELERY_CONCURRENCE=2
