# =============================================================================
# ALPHA — variables d'environnement (modèle, AUCUN secret réel)
#
# Ne modifiez pas ce fichier pour vos valeurs locales : copiez-le en .env.
# Le plus simple :  scripts/dev.ps1 init   (Windows)   ou   scripts/dev.sh init
# La commande copie ce fichier en .env et remplace chaque valeur A_GENERER par
# un secret aléatoire. Le fichier .env est ignoré par Git : ne le commitez jamais.
#
# Règles :
#   - une variable par ligne, NOM=valeur, sans guillemets ni espaces autour du « = » ;
#   - fins de ligne LF (voir docs/ops/dev.md si Docker lit des « \r ») ;
#   - les mots de passe PostgreSQL sont insérés dans des URL de connexion :
#     n'utilisez que [A-Za-z0-9] (init génère de l'hexadécimal), 16 caractères minimum.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Superutilisateur `postgres` : sert UNIQUEMENT au script d'initialisation
# (infra/postgres/init/01-roles.sh) et au dépannage. Jamais utilisé par l'application.
POSTGRES_PASSWORD=A_GENERER

# Propriétaire de la base, du schéma et des tables (BYPASSRLS) : uniquement le
# service `migrate`, les tests et les commandes d'exploitation.
ALPHA_OWNER_PASSWORD=A_GENERER

# Rôle applicatif (backend, worker, beat), soumis à la RLS, propriétaire de rien.
# Doit être DIFFÉRENT du mot de passe d'alpha_owner.
ALPHA_APP_PASSWORD=A_GENERER

# CREATEDB pour alpha_owner (création de la base de test par pytest).
# true en développement et en CI uniquement ; false en recette et en production.
ALPHA_OWNER_CREATEDB=true

# Nom de la base applicative.
ALPHA_DB_NAME=alpha

# Attention : les mots de passe et ALPHA_OWNER_CREATEDB ne sont lus qu'à la
# PREMIÈRE création du volume de données. Après modification : scripts/dev.ps1 reset
# (efface la base locale).

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Clé secrète Django (50 caractères aléatoires).
DJANGO_SECRET_KEY=A_GENERER
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# URL publique du frontend, utilisée dans les liens des e-mails (activation, réinitialisation).
ALPHA_URL_FRONTEND=http://localhost:3000

# --- Secrets applicatifs (architecture § 4.4 et § 4.9) ------------------------
# Clés MultiFernet séparées par des virgules : la PREMIÈRE chiffre, toutes déchiffrent.
# Format : 32 octets aléatoires en base64 « URL-safe » (44 caractères, finit par « = »).
ALPHA_CLES_CHIFFREMENT=A_GENERER
# Poivre HMAC-SHA256 des codes de secours et des clés de limitation de débit.
ALPHA_HMAC_POIVRE=A_GENERER

# --- E-mails (Mailpit en développement) -----------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=ALPHA <no-reply@alpha.localhost>

# --- Frontend -----------------------------------------------------------------
# true UNIQUEMENT si le dépôt est sur le disque Windows (C:\...) : active la
# surveillance des fichiers par scrutation. Laisser false si le dépôt est dans WSL2.
WATCHPACK_POLLING=false

# --- Poste de développement ---------------------------------------------------
# UID/GID de votre utilisateur WSL (commande `id` dans Ubuntu ; 1000 en général).
ALPHA_UID=1000
ALPHA_GID=1000

# Ports publiés sur 127.0.0.1 (à changer si un port est déjà pris, voir docs/ops/dev.md).
ALPHA_PORT_FRONTEND=3000
ALPHA_PORT_BACKEND=8000
ALPHA_PORT_MAILPIT=8025
ALPHA_PORT_DB=5432
