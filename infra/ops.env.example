# =============================================================================
# ALPHA — configuration d'exploitation du VPS (sauvegarde, restauration, veille)
#
# À copier en /etc/alpha/ops.env (root:root, droits 600), HORS du dépôt :
#     sudo install -d -m 700 /etc/alpha
#     sudo install -m 600 infra/ops.env.example /etc/alpha/ops.env
# Lu par scripts/sauvegarde.sh, restauration.sh et veille.sh (ops-commun.sh).
# Voir docs/ops/deploiement.md § 8 et docs/ops/monitoring.md.
#
# Format : NOM=valeur, sans espaces autour du « = » ; fichier « sourcé » par bash.
# =============================================================================

# --- Accès à PostgreSQL ------------------------------------------------------
# docker : outils du conteneur db de chaque projet compose (cas du VPS).
ALPHA_PG_MODE=docker

# --- Sauvegarde ----------------------------------------------------------------
# Clé(s) PUBLIQUE(S) age (une par ligne, « age1… ») ; la clé privée reste HORS
# du serveur (coffre FYXOP + copie papier/clé USB au coffre). Deux clés
# conseillées : celle de l'exploitant et une clé de secours de la direction.
ALPHA_SAUVEGARDE_DESTINATAIRES=/etc/alpha/sauvegarde-destinataires.txt

# Destination rclone : <remote>:<bucket>[/préfixe]. Le remote est décrit dans
# RCLONE_CONFIG (voir docs/ops/deploiement.md § 8.1 : stockage objet S3 HORS
# Hostinger, clé d'accès SANS droit de suppression, verrouillage objet conseillé).
ALPHA_SAUVEGARDE_DESTINATION=alpha-hors-site:alpha-sauvegardes
RCLONE_CONFIG=/etc/alpha/rclone.conf

# Copie locale (chiffrée) gardée sur le VPS pour une restauration rapide.
ALPHA_SAUVEGARDE_SPOOL=/var/backups/alpha
ALPHA_SAUVEGARDE_RETENTION_LOCALE_JOURS=3
# complete : empreinte MD5 du contenu de chaque table (restauration vérifiée
# ligne à ligne) ; comptes : nombre de lignes seulement (bases très volumineuses).
ALPHA_SAUVEGARDE_EMPREINTE_DONNEES=complete

# --- Surveillance (docs/ops/monitoring.md) -----------------------------------------
# URL des sondes « push » : Uptime Kuma (…/api/push/<jeton>) ou Healthchecks.io
# (https://hc-ping.com/<uuid>). Vide = pas de signal (déconseillé).
ALPHA_SAUVEGARDE_PING_URL_PROD=
ALPHA_SAUVEGARDE_PING_URL_RECETTE=
ALPHA_AUDIT_PING_URL_PROD=
ALPHA_AUDIT_PING_URL_RECETTE=
# Battement de cœur du VPS (toutes les 5 min) : son absence = VPS injoignable.
ALPHA_VEILLE_PING_URL=

# Seuils de veille.sh systeme.
ALPHA_VEILLE_SEUIL_DISQUE_PCT=85
ALPHA_VEILLE_SEUIL_RAM_DISPO_MO=500
ALPHA_VEILLE_SEUIL_SWAP_PCT=60
ALPHA_VEILLE_REDEMARRAGES_MAX=5
ALPHA_VEILLE_SAUVEGARDE_AGE_MAX_H=26
# Projets contrôlés ; vide = détection automatique (proxy + environnements déployés).
ALPHA_VEILLE_PROJETS=
